# 复制本文件为 config.env 后按需修改

# 项目根目录（默认：脚本所在目录，一般不用改）
# ROOT_DIR="/path/to/fengling-dashboard-kit"

# 每日源文件下载目录
DOWNLOADS_DIR="$HOME/Downloads"

# Excel 样式模板（默认使用项目内 templates/）
# STYLE_AUTH_TEMPLATE=""
# STYLE_SALES_TEMPLATE=""

# GitHub Pages 固定链接（发布成功后提示用）
PAGES_URL="https://你的用户名.github.io/你的仓库名/"

# 访问统计（可选，配一个或多个；重新生成看板后生效）
# Google Analytics 4 测量 ID（在 GA4 后台创建媒体资源后获得）
# GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# 百度统计站点 ID（在百度统计后台获得）
# BAIDU_SITE_ID=""
# GoatCounter 站点域名（注册后在站点设置中查看，如 xxx.goatcounter.com）
# GOATCOUNTER_SITE=""
# 页面内展示 PV/UV（第三方不蒜子，零配置但数据有延迟）
# VISIT_COUNTER="busuanzi"
