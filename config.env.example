# 复制本文件为 config.env 后按需修改

# 项目根目录（默认：脚本所在目录，一般不用改）
# ROOT_DIR="/path/to/fengling-dashboard-kit"

# 每日源文件下载目录
DOWNLOADS_DIR="$HOME/Downloads"

# Excel 样式模板（默认使用项目内 templates/）
# STYLE_AUTH_TEMPLATE=""
# STYLE_SALES_TEMPLATE=""

# GitHub Pages 固定链接（发布成功后提示用）
PAGES_URL="https://你的用户名.github.io/你的仓库名/"

# 访问统计（可选，配一个或多个；重新生成看板后生效）
# Google Analytics 4 测量 ID（在 GA4 后台创建媒体资源后获得）
# GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# 百度统计站点 ID（在百度统计后台获得）
# BAIDU_SITE_ID=""
# GoatCounter 站点域名（注册后在站点设置中查看，如 xxx.goatcounter.com）
# GOATCOUNTER_SITE=""
# 页面内展示 PV/UV（第三方不蒜子，零配置但数据有延迟）
# VISIT_COUNTER="busuanzi"

# --- 爱梦 Datart 自动导出（fetch_aimeng_exports.py / fetch_and_publish_daily.sh）---
# AIMENG_BASE_URL="https://aimeng.yuaiweiwu.com"
# AIMENG_ORG_ID="cc4dfcf4f75a434988276c3f2464dde7"
# 看板目录页 URL 中的一段 ID（用于 discover 时缩小范围）
# AIMENG_FOLDER_ID="638407de027b495d99f80ab0175ba1b9"
# 推荐：浏览器登录后复制任意 /api/v1 请求的 Authorization 头（会过期，需定期更新）
# AIMENG_TOKEN="eyJ..."
# 或账号密码登录（若公司策略允许）
# AIMENG_USERNAME=""
# AIMENG_PASSWORD=""
# 运行 python3 fetch_aimeng_exports.py --discover 后可填 4 个图表 ID（更稳定）
# AIMENG_CHART_SALES=""
# AIMENG_CHART_AUTH_HIGH=""
# AIMENG_CHART_WECHAT=""
# AIMENG_CHART_AUTH_AIXUE=""
